{
  "id": "lab",
  "version": "0.0.0",
  "scopes": {
    "investigate": { "description": "Open-ended investigation or root-cause diagnosis of an unclear problem." }
  },
  "models": {
    "claude-sonnet-5-5": {
      "rules": [
        {
          "id": "sonnet/general",
          "file": "rules/sonnet-general.md",
          "scopes": ["*"],
          "where": ["session", "unattended", "subagent"],
          "source": { "url": "https://example.com/lab/sonnet", "section": "General", "date": "2026-11-14" }
        },
        {
          "id": "sonnet/investigate",
          "file": "rules/sonnet-investigate.md",
          "scopes": ["investigate"],
          "where": ["session", "unattended", "subagent"],
          "source": { "url": "https://example.com/lab/sonnet", "section": "Investigation", "date": "2026-11-14" }
        },
        {
          "id": "sonnet/carry-through",
          "file": "rules/sonnet-carry-through.md",
          "scopes": ["*"],
          "where": ["unattended", "subagent"],
          "source": { "url": "https://example.com/lab/sonnet", "section": "Carrying work through", "date": "2026-11-14" }
        },
        {
          "id": "sonnet/progress-updates",
          "file": "rules/sonnet-progress-updates.md",
          "scopes": ["*"],
          "where": ["session"],
          "enabled": false,
          "source": { "url": "https://example.com/lab/sonnet", "section": "Progress updates", "date": "2026-11-14" }
        }
      ]
    },
    "claude-haiku-5-5": {
      "rules": [
        {
          "id": "haiku/general",
          "file": "rules/haiku-general.md",
          "scopes": ["*"],
          "where": ["session", "unattended", "subagent"],
          "source": { "url": "https://example.com/lab/haiku", "section": "General", "date": "2026-11-14" }
        }
      ]
    }
  }
}
